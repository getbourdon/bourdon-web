---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
import { getCollection } from 'astro:content';

const recentPosts = (await getCollection('blog'))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 5);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<section class="intro">
				<h1>Bourdon Blog</h1>
				<p class="lede">
					Field notes from building Bourdon — recognition-first runtime + agent federation memory.
				</p>
				<p>
					Long-form writing on what we're building, what we've learned, and what's not working yet. Project home: <a href="https://bourdon.ai">bourdon.ai</a>. Source: <a href="https://github.com/getbourdon/bourdon">github.com/getbourdon/bourdon</a>.
				</p>
			</section>

			<hr />

			<section>
				<h2>Recent posts</h2>
				{recentPosts.length === 0 ? (
					<p><em>No posts yet — first one coming soon.</em></p>
				) : (
					<ul class="post-list">
						{recentPosts.map((post) => (
							<li>
								<a href={`/blog/${post.id}/`}>
									<h3>{post.data.title}</h3>
									<p class="meta"><FormattedDate date={post.data.pubDate} /></p>
									<p class="excerpt">{post.data.description}</p>
								</a>
							</li>
						))}
					</ul>
				)}
				<p><a href="/blog">All posts →</a></p>
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	.intro {
		padding: 2em 0 1em;
	}
	.intro h1 {
		font-size: 3em;
		margin-bottom: 0.3em;
	}
	.lede {
		font-size: 1.3em;
		line-height: 1.4;
		color: rgb(var(--gray-dark));
		margin-bottom: 1em;
	}
	hr {
		margin: 2em 0;
	}
	.post-list {
		list-style: none;
		padding: 0;
		margin: 0;
	}
	.post-list li {
		margin-bottom: 1.5em;
		border-bottom: 1px solid rgb(var(--gray-light));
		padding-bottom: 1.5em;
	}
	.post-list li:last-child {
		border-bottom: none;
	}
	.post-list a {
		text-decoration: none;
		color: inherit;
		display: block;
	}
	.post-list a:hover h3 {
		color: var(--accent);
	}
	.post-list h3 {
		margin: 0 0 0.3em;
		font-size: 1.5em;
		color: rgb(var(--black));
		transition: color 0.15s;
	}
	.post-list .meta {
		font-size: 0.85em;
		color: rgb(var(--gray));
		margin: 0 0 0.5em;
	}
	.post-list .excerpt {
		font-size: 0.95em;
		color: rgb(var(--gray-dark));
		margin: 0;
	}
	@media (max-width: 720px) {
		.intro h1 {
			font-size: 2.2em;
		}
		.lede {
			font-size: 1.1em;
		}
	}
</style>
